{
  "info": {
    "name": "Payment Service (RetailFlow)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [ { "key": "baseUrl", "value": "http://localhost:8093" } ],
  "item": [
    {
      "name": "Process Payment",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/payments",
        "body": { "mode": "raw", "raw": "{\n  \"invoiceId\": 1,\n  \"amount\": 175.0,\n  \"method\": \"CARD\"\n}" }
      }
    },
    { "name": "Get All Payments", "request": { "method": "GET", "url": "{{baseUrl}}/api/payments" } },
    { "name": "Get Payment By Id", "request": { "method": "GET", "url": "{{baseUrl}}/api/payments/1" } },
    { "name": "Get By Invoice", "request": { "method": "GET", "url": "{{baseUrl}}/api/payments/invoice/1" } },
    { "name": "Get Paginated", "request": { "method": "GET", "url": "{{baseUrl}}/api/payments/paginated?page=0&size=5" } },
    {
      "name": "Update Payment Method",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/payments/1",
        "body": { "mode": "raw", "raw": "{\n  \"invoiceId\": 1,\n  \"amount\": 175.0,\n  \"method\": \"UPI\"\n}" }
      }
    },
    { "name": "Refund Payment", "request": { "method": "PATCH", "url": "{{baseUrl}}/api/payments/1/refund" } }
  ]
}
